{
  "name": "snapper",
  "version": "1.4.2",
  "private": true,
  "description": "Playtest capture for web games.",
  "author": "Maxim Starkweather",
  "homepage": "https://maximstark.art/snapper/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximstark/snapper.git"
  },
  "bugs": "https://github.com/maximstark/snapper/issues",
  "license": "MIT",
  "type": "module",
  "main": "packages/host/main/entry.mjs",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "snapper": "packages/host/bin/snapper.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "demo": "node bin/snapper.mjs play examples/demo",
    "launcher": "electron packages/host/main/entry.mjs",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:exe": "node scripts/verify-exe.mjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.maximstark.snapper",
    "productName": "Snapper",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "packages/**",
      "bin/**",
      "examples/**",
      "package.json",
      "!**/node_modules/**",
      "!**/*.test.mjs",
      "!sessions/**",
      "!docs/**",
      "!tests/**",
      "!scripts/**",
      "!**/.snapper/**",
      "!private/**"
    ],
    "extraFiles": [
      {
        "from": "build/snapper.cmd",
        "to": "snapper.cmd"
      },
      {
        "from": "build/README.txt",
        "to": "README.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
